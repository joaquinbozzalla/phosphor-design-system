{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Phosphor CRT design system — brand-agnostic. W3C DTCG design tokens. Two canonical themes: dark (phosphor-on-black) and light (green ink on parchment).",
  "color": {
    "$type": "color",
    "dark": {
      "$description": "Dark mode (default) — phosphor-on-black.",
      "bg-0":    { "$value": "#000503", "$description": "Deepest void behind everything" },
      "bg-1":    { "$value": "#04110b", "$description": "Page background" },
      "bg-2":    { "$value": "#06180f", "$description": "Card / panel" },
      "bg-3":    { "$value": "#0a2418", "$description": "Raised / hover" },
      "bg-inset":{ "$value": "#020a06", "$description": "Inset — input, code block" },
      "fg-0":    { "$value": "#c8ffd9", "$description": "Highest contrast / titles" },
      "fg-1":    { "$value": "#6fff9c", "$description": "Default body" },
      "fg-2":    { "$value": "#3ddc7a", "$description": "Secondary / labels" },
      "fg-3":    { "$value": "#1f8a4d", "$description": "Muted / placeholder" },
      "fg-4":    { "$value": "#0d4a29", "$description": "Very muted / dividers" },
      "primary":       { "$value": "#39ff7a", "$description": "Iconic phosphor green" },
      "primary-hover": { "$value": "#6fff9c" },
      "primary-press": { "$value": "#1fd95f" },
      "primary-ink":   { "$value": "#021107", "$description": "Text on primary" },
      "accent":  { "$value": "#ffb84a", "$description": "Amber CRT accent" },
      "success": { "$value": "#39ff7a" },
      "warning": { "$value": "#ffb84a" },
      "danger":  { "$value": "#ff4d4d" },
      "info":    { "$value": "#4dd0ff" },
      "border-1": { "$value": "rgba(57, 255, 122, 0.18)", "$description": "Hairline divider" },
      "border-2": { "$value": "rgba(57, 255, 122, 0.32)", "$description": "Card border" },
      "border-3": { "$value": "rgba(57, 255, 122, 0.55)", "$description": "Active / focus" },
      "border-dashed": { "$value": "rgba(57, 255, 122, 0.28)", "$description": "Empty states / dropzones only" }
    },
    "light": {
      "$description": "Light mode — green ink on parchment (printout inversion).",
      "bg-0":    { "$value": "#e8ecd9" },
      "bg-1":    { "$value": "#f1f3e3" },
      "bg-2":    { "$value": "#f7f8ec" },
      "bg-3":    { "$value": "#ecefd6" },
      "bg-inset":{ "$value": "#e0e4cf" },
      "fg-0":    { "$value": "#0a3318" },
      "fg-1":    { "$value": "#0f5a2a" },
      "fg-2":    { "$value": "#1e7a40" },
      "fg-3":    { "$value": "#4a9b66" },
      "fg-4":    { "$value": "#8ab59c" },
      "primary":       { "$value": "#0f7a3a" },
      "primary-hover": { "$value": "#0a5a2a" },
      "primary-press": { "$value": "#074421" },
      "primary-ink":   { "$value": "#f1f3e3" },
      "accent":  { "$value": "#b8631a" },
      "success": { "$value": "#0f7a3a" },
      "warning": { "$value": "#b8631a" },
      "danger":  { "$value": "#b41818" },
      "info":    { "$value": "#1064a6" },
      "border-1": { "$value": "rgba(15, 90, 42, 0.18)" },
      "border-2": { "$value": "rgba(15, 90, 42, 0.35)" },
      "border-3": { "$value": "rgba(15, 90, 42, 0.7)" },
      "border-dashed": { "$value": "rgba(15, 90, 42, 0.4)" }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": { "$value": ["IBM Plex Mono", "SF Mono", "Menlo", "Consolas", "ui-monospace", "monospace"], "$description": "Primary family — UI + display + body" },
    "mono": { "$value": ["IBM Plex Mono", "SF Mono", "Menlo", "Consolas", "monospace"], "$description": "Labels, code, terminal output" }
  },
  "fontSize": {
    "$type": "dimension",
    "xs":  { "$value": "11px" },
    "sm":  { "$value": "13px" },
    "md":  { "$value": "15px", "$description": "Body" },
    "lg":  { "$value": "18px" },
    "xl":  { "$value": "22px" },
    "2xl": { "$value": "28px" },
    "3xl": { "$value": "36px" },
    "4xl": { "$value": "48px" },
    "5xl": { "$value": "64px" },
    "6xl": { "$value": "88px" }
  },
  "lineHeight": {
    "$type": "number",
    "tight":  { "$value": 1.05 },
    "snug":   { "$value": 1.2 },
    "normal": { "$value": 1.5 },
    "loose":  { "$value": 1.7 }
  },
  "letterSpacing": {
    "$type": "dimension",
    "tight":  { "$value": "-0.02em" },
    "normal": { "$value": "0" },
    "wide":   { "$value": "0.08em" },
    "wider":  { "$value": "0.16em", "$description": "Monospace UI labels" }
  },
  "spacing": {
    "$type": "dimension",
    "0":  { "$value": "0" },
    "1":  { "$value": "4px" },
    "2":  { "$value": "8px" },
    "3":  { "$value": "12px" },
    "4":  { "$value": "16px" },
    "5":  { "$value": "24px" },
    "6":  { "$value": "32px" },
    "7":  { "$value": "48px" },
    "8":  { "$value": "64px" },
    "9":  { "$value": "96px" },
    "10": { "$value": "128px" }
  },
  "radius": {
    "$type": "dimension",
    "0":    { "$value": "0" },
    "1":    { "$value": "2px", "$description": "Default — barely rounded" },
    "2":    { "$value": "4px", "$description": "Cards" },
    "3":    { "$value": "8px", "$description": "Buttons (max)" },
    "4":    { "$value": "14px", "$description": "Modals (max)" },
    "pill": { "$value": "999px", "$description": "Tags, progress, segmented controls only" }
  },
  "borderWidth": {
    "$type": "dimension",
    "1": { "$value": "1px" },
    "2": { "$value": "2px" }
  },
  "duration": {
    "$type": "duration",
    "fast":  { "$value": "120ms" },
    "base":  { "$value": "220ms" },
    "slow":  { "$value": "400ms" },
    "sweep": { "$value": "900ms", "$description": "Boot / scan effects" }
  },
  "easing": {
    "$type": "cubicBezier",
    "out":    { "$value": [0.16, 1, 0.3, 1] },
    "in-out": { "$value": [0.65, 0, 0.35, 1] },
    "spring": { "$value": [0.34, 1.56, 0.64, 1] }
  },
  "shadow": {
    "$description": "Dark mode uses phosphor glow; light mode uses hard printed offsets.",
    "dark": {
      "glow-sm": { "$value": "0 0 6px rgba(57, 255, 122, 0.25)" },
      "glow-md": { "$value": "0 0 14px rgba(57, 255, 122, 0.35), 0 0 2px rgba(57, 255, 122, 0.6)" },
      "glow-lg": { "$value": "0 0 28px rgba(57, 255, 122, 0.45), 0 0 4px rgba(57, 255, 122, 0.7)" },
      "text-glow-sm": { "$value": "0 0 2px rgba(57, 255, 122, 0.6)" },
      "text-glow-md": { "$value": "0 0 4px rgba(57, 255, 122, 0.8), 0 0 8px rgba(57, 255, 122, 0.4)" },
      "text-glow-lg": { "$value": "0 0 8px rgba(57, 255, 122, 0.9), 0 0 18px rgba(57, 255, 122, 0.5)" }
    },
    "light": {
      "glow-sm": { "$value": "0 1px 0 rgba(15, 90, 42, 0.06)" },
      "glow-md": { "$value": "0 2px 0 rgba(15, 90, 42, 0.1), 0 0 0 1px rgba(15, 90, 42, 0.08)" },
      "glow-lg": { "$value": "0 4px 0 rgba(15, 90, 42, 0.12), 0 0 0 1px rgba(15, 90, 42, 0.1)" }
    }
  }
}
